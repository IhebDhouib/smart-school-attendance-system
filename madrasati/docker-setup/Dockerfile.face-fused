# Fused Face API + Detection Dockerfile
# This container runs three services:
# 1. Face Encoding API (faceapi.py) - port 8000
# 2. Unknown Faces API (unknown_faces_api_fastapi.py) - port 5001
# 3. Real-time Face Detection App (app_with_env.py)

FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries \
    && echo 'Acquire::http::Timeout "60";' >> /etc/apt/apt.conf.d/80-retries \
    && apt-get -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
    # Basic utilities
    apt-transport-https \
    ca-certificates \
    curl \
    # Build tools
    build-essential \
    cmake \
    git \
    wget \
    # OpenCV dependencies
    libopencv-dev \
    python3-opencv \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1 \
    # Additional libraries for InsightFace
    libxcb1 \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire project structure
COPY madrasati/ /app/madrasati/
COPY docker-setup/ /app/docker-setup/

# Install Python dependencies from fused requirements
COPY madrasati/face/requirements-fused.txt /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-fused.txt

# Create necessary directories with proper permissions
RUN mkdir -p \
    /app/madrasati/face/dataset \
    /app/madrasati/face/unknown_faces \
    /app/madrasati/face/logs \
    /app/madrasati/face/encodings \
    /root/.insightface/models && \
    chmod -R 755 /app/madrasati/face

# Set Python environment variables (app-specific configs are in docker-compose)
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/madrasati:/app/madrasati/face

# Expose ports
EXPOSE 8000 5001 8501

# Copy and make startup script executable
COPY docker-setup/start_face_services_fused.sh /app/
RUN chmod +x /app/start_face_services_fused.sh

# Health check - wget sans --spider pour forcer GET
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --quiet --tries=1 -O /dev/null http://localhost:8000/students/encodings/status || exit 1

# Run the startup script
CMD ["/app/start_face_services_fused.sh"]
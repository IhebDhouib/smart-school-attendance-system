# Angular Frontend Dockerfile
FROM node:18-alpine AS build

WORKDIR /app

# Copy package files
COPY madrasati/madrasati/madrassati/package*.json ./

# Install ALL dependencies (not just production)
RUN npm ci

# Copy source code
COPY madrasati/madrasati/madrassati/ .

# Build the Angular app
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built app to nginx
COPY --from=build /app/dist/madrassati /usr/share/nginx/html

# Copy nginx config
COPY madrasati/docker-setup/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
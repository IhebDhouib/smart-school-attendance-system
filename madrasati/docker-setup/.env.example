# Madrasati Docker Environment Configuration
# Copy this file to .env and customize the values for your environment

# MongoDB Configuration
MONGO_PASSWORD=madrasati123

# JWT Secret (IMPORTANT: Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random

# Camera Configuration for Face Detection
# Entry cameras (comma-separated list of sources)
ENTRY_CAMERA_1=http://192.168.1.66:8080/video
ENTRY_CAMERA_2=1

# Exit cameras (comma-separated list of sources)
EXIT_CAMERA_1=0
EXIT_CAMERA_2=http://192.168.1.68:5001/video
EXIT_CAMERA_3=0

# Network Configuration (optional - for custom network setup)
# DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Development/Production Mode
NODE_ENV=production

# Ports (optional - only change if you have conflicts)
# FRONTEND_PORT=80
# BACKEND_PORT=3000
# WEBSOCKET_PORT=3001
# FACE_API_PORT=8000
# MONGODB_PORT=27017

# ============================================
# GOOGLE DRIVE BACKUP CONFIGURATION
# ============================================

# Enable/disable Google Drive backup
ENABLE_GOOGLE_DRIVE_BACKUP=true

# Method 1: Service Account JSON as Environment Variable (Recommended for Production)
# Copy the entire contents of your google-service-account.json file here
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"madrasati-drive-backup@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Method 2: Service Account JSON File Path (For Development)
# GOOGLE_SERVICE_ACCOUNT_PATH=./config/google-service-account.json

# Camera Configuration for Single Camera Face Detection (Face Fused Service)
CAMERA_URL=rtsp://admin:admin1234@10.3.8.9:554/cam/realmonitor?channel=7&subtype=0&bitrate=4096&fps=25


# Python Face Detection Server Dockerfile
FROM python:3.9-slim

WORKDIR /app

# Install system dependencies for OpenCV and face_recognition
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopencv-dev \
    python3-opencv \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*


# Copy requirements for face-detection
COPY madrasati/madrasati/face/requirements-face-detection.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-face-detection.txt

# Copy face service files
COPY madrasati/madrasati/face/ .

# Copy the environment-aware face detection script
COPY madrasati/docker-setup/app_with_env.py ./app_with_env.py

# Copy the encoding synchronization script
COPY madrasati/docker-setup/sync_encodings_with_db.py ./sync_encodings_with_db.py

# Copy the unknown faces API script
COPY madrasati/docker-setup/unknown_faces_api.py ./unknown_faces_api.py

# Copy the startup script
COPY madrasati/docker-setup/start_face_services.sh ./start_face_services.sh

# Create necessary directories
RUN mkdir -p dataset unknown_faces logs encodings

# Set permissions
RUN chmod +x *.py *.sh

EXPOSE 5000 5001

CMD ["sh", "-c", "chmod +x start_face_services.sh && ./start_face_services.sh"]
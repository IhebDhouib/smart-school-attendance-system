# ===================================================================
# MADRASATI CAMERA CONFIGURATION
# ===================================================================
# This file contains all camera settings for the face detection system.
# Update the IP addresses here and restart the containers to apply changes.
# 
# Instructions:
# 1. Update the IP addresses below to match your cameras
# 2. Run: docker-compose restart face-detection
# 3. The changes will be applied automatically
# ===================================================================

# ENTRY CAMERAS (Students entering the school)
# Format: http://IP_ADDRESS:PORT/video (for IP cameras)
# Format: 0, 1, 2, etc. (for USB cameras)
ENTRY_CAMERA_1=http://192.168.1.222:8080/video
ENTRY_CAMERA_2=1

# EXIT CAMERAS (Students leaving the school)  
# Format: http://IP_ADDRESS:PORT/video (for IP cameras)
# Format: 0, 1, 2, etc. (for USB cameras)
EXIT_CAMERA_1=http://192.168.1.223:8080/video
EXIT_CAMERA_2=0
EXIT_CAMERA_3=0

# ===================================================================
# NETWORK SETTINGS
# ===================================================================
# Camera connection timeout (seconds)
CAMERA_TIMEOUT=5

# Video frame width and height for processing
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Face detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE=0.6

# ===================================================================
# OTHER SYSTEM SETTINGS (usually don't need to change)
# ===================================================================

# MongoDB Configuration
MONGO_PASSWORD=madrasati123

# JWT Secret (IMPORTANT: Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random

# Development/Production Mode
NODE_ENV=production

# Ports (optional - only change if you have conflicts)
# FRONTEND_PORT=80
# BACKEND_PORT=3000
# WEBSOCKET_PORT=3001
# FACE_API_PORT=8000
# MONGODB_PORT=27017


# FastAPI Face Encoding Service Dockerfile
FROM python:3.9-slim

WORKDIR /app

# Install system dependencies for OpenCV and face_recognition
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopencv-dev \
    python3-opencv \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements for face-api
COPY face/requirements-face-api.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-face-api.txt

# Copy face service files
COPY face/ .

# Create necessary directories
RUN mkdir -p dataset unknown_faces logs encodings

# Copy the existing encodings file for initialization
COPY face/encodings.pkl ./encodings.pkl

# Set permissions
RUN chmod +x *.py

EXPOSE 8000

# Set Python path and run
ENV PYTHONPATH=/app
CMD ["sh", "-c", "mkdir -p /app/encodings && cp -f /app/encodings.pkl /app/encodings/encodings.pkl && python -m uvicorn faceapi:app --host 0.0.0.0 --port 8000"]


# Node.js Backend Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY backend/package*.json ./

# Install dependencies
RUN npm ci 

# Copy source code
COPY backend/ .

# Create uploads directory
RUN mkdir -p uploads logs

# Set permissions
RUN chown -R node:node /app

USER node

EXPOSE 3000

CMD ["npm", "start"]


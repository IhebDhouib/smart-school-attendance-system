# Environment Configuration for Face Recognition Services
# Copy this file to .env and adjust values as needed

# ============================================
# Backend Connection
# ============================================
BACKEND_URL=http://localhost:3000
WEBSOCKET_URL=ws://localhost:3001

# For Docker deployment, use service names:
# BACKEND_URL=http://backend:3000
# WEBSOCKET_URL=ws://backend:3001

# ============================================
# File Paths
# ============================================
DATASET_DIR=dataset
ENCODINGS_FILE_ARCFACE=encodings_arcface.pkl
UNKNOWN_FACES_DIR=unknown_faces
LOG_DIR=logs

# For Docker deployment with absolute paths:
# DATASET_DIR=/app/madrasati/face/dataset
# ENCODINGS_FILE_ARCFACE=/app/madrasati/face/encodings_arcface.pkl
# UNKNOWN_FACES_DIR=/app/madrasati/face/unknown_faces
# LOG_DIR=/app/madrasati/face/logs

# ============================================
# InsightFace Configuration (RetinaFace + ArcFace)
# ============================================
INSIGHTFACE_MODEL=buffalo_l
# Options: buffalo_l (accurate, ~280MB), buffalo_s (fast, ~30MB)

USE_GPU=False
# Set to True if you have CUDA-capable GPU

DET_SIZE=640
# Detection input size: 320 (fast) or 640 (accurate)

DET_THRESH=0.5
# Detection confidence threshold (0.0-1.0)
# Lower = more sensitive (more detections, more false positives)
# Higher = stricter (fewer detections, may miss faces)
# Recommended: 0.3-0.7

REC_THRESH=0.45
# Recognition similarity threshold (0.0-1.0)
# Higher = stricter matching (fewer false matches)
# Lower = lenient matching (more matches, more false positives)
# Recommended: 0.35-0.55

# ============================================
# Image Enhancement
# ============================================
ENABLE_ESRGAN=False
# Enable Real-ESRGAN super-resolution enhancement
# Set to True for better quality but slower processing
# Requires: pip install realesrgan basicsr

# ============================================
# Notes
# ============================================
# - For local development: use localhost URLs and relative paths
# - For Docker deployment: use service names and absolute container paths
# - GPU acceleration requires onnxruntime-gpu and CUDA
# - Lower thresholds = more sensitive detection/recognition
# - Higher thresholds = stricter, more accurate but may miss faces
